# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET=your_bucket_name

# Optional: S3 folder prefix for recordings
S3_RECORDINGS_FOLDER=webrtc-recordings/

# Webhook do iLibras_v2 — chamado quando a gravação termina de processar
ILIBRAS_WEBHOOK_URL=https://sistema.ilibras.com.br
ILIBRAS_WEBHOOK_TOKEN=your_shared_secret_token

# TURN — servidor de retransmissão de mídia. Sem ele, quem está atrás de rede
# fechada (empresa, 4G com CGNAT, Wi-Fi de hospital) não troca vídeo: a sala
# abre, o quadro do outro lado fica preto e a chamada não conecta.
# TURN_URLS: separados por vírgula.
# TURN_SECRET: o static-auth-secret do coturn (use-auth-secret) — gera
# credencial temporária a cada conexão. Para provedor com usuário/senha fixos,
# deixe TURN_SECRET vazio e preencha TURN_USERNAME/TURN_CREDENTIAL.
TURN_URLS=
TURN_SECRET=
TURN_TTL_SEGUNDOS=86400
TURN_USERNAME=
TURN_CREDENTIAL=
# STUN_URLS=stun:stun.l.google.com:19302

# Tamanho máximo da gravação, em MB. A 2,5 Mbps uma hora de chamada dá ~1,1 GB.
# O client_max_body_size do nginx na frente precisa ser maior que isto.
GRAVACAO_MAX_MB=1500
