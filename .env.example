# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET=your_bucket_name

# Optional: S3 folder prefix for recordings
S3_RECORDINGS_FOLDER=webrtc-recordings/

# Webhook do iLibras_v2 — chamado quando a gravação termina de processar
ILIBRAS_WEBHOOK_URL=https://sistema.ilibras.com.br
ILIBRAS_WEBHOOK_TOKEN=your_shared_secret_token
